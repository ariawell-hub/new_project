{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-check.mjs\"",
            "shell": "bash",
            "timeout": 120,
            "statusMessage": "커밋 전 검사 훅 확인 중…"
          }
        ]
      }
    ]
  }
}
