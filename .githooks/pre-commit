#!/bin/sh
# 커밋 전에 린트 → 빌드 → 테스트(npm run check)를 돌리고, 하나라도 실패하면 커밋을 막는다.
# npm install 하면 prepare 스크립트가 `git config core.hooksPath .githooks`를 설정한다.
echo "[pre-commit] npm run check (lint → build → test)"
if ! npm run check --silent; then
  echo "[pre-commit] 검사가 실패해서 커밋을 중단했어요. 위 오류를 고친 뒤 다시 커밋하세요." >&2
  exit 1
fi
